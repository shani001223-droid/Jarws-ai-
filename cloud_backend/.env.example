# Copy these into your cloud host's environment settings. Never commit real secrets.
ALLOWED_ORIGINS=https://YOUR-GITHUB-PAGES-ORIGIN
# AI_PROVIDER_API_KEY=add-only-after-choosing-a-provider

# Paste the actual key only in your backend host secret environment.
# OpenRouter becomes primary when this key is set; otherwise Gemini/Groq stay unchanged.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional Free-LLM directory integrations (secrets only in backend host!)
# Source: https://github.com/nejib1/Free-LLM
# Keys are NOT included in that repository. Sign up on each provider's official
# portal and configure ONLY eligible, rate-limited free/developer plans.
# The Hoshi adapter uses pinned model IDs and fixed HTTPS hosts; *_MODEL and
# *_BASE_URL overrides are intentionally unsupported to avoid accidental billing.
ZAI_API_KEY=

# Mistral: enable ONLY with a confirmed no-billing FREE mode workspace.
# The Free plan may have privacy/data-use conditions and request quotas.
MISTRAL_API_KEY=
MISTRAL_FREE_MODE=false

# NVIDIA developer API is for prototyping, not commercial production.
# Enable ONLY with free developer key and permitted use.
NVIDIA_API_KEY=
NVIDIA_PROTOTYPE_MODE=false

# Existing Hoshi model provider keys remain supported:
GEMINI_API_KEY=
GROQ_API_KEY=
OPENJARVIS_URL=
OPENJARVIS_MODEL=
